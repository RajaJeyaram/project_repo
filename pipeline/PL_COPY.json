{
	"name": "PL_COPY",
	"properties": {
		"activities": [
			{
				"name": "Lookup1",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from ctrl.table_config where table_id = @{pipeline().parameters.table_id}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"firstRowOnly": true
				}
			},
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "If Condition1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlV2Source",
						"query": {
							"value": "select * from public.@{activity('Lookup1').output.firstRow.source_table_name}",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_POSTGRE1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_PARQUET1",
						"type": "DatasetReference",
						"parameters": {
							"container": "landing",
							"folder": {
								"value": "@concat(activity('Lookup1').output.firstRow.source_system,'/',activity('Lookup1').output.firstRow.source_table_name,'/',variables('Date'))",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "curr_Date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "Date",
					"value": {
						"value": "@formatDateTime(utcNow(),'yyyy-MM-dd_hh:mm:ss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "landing-bronze",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "Copy data1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Healthcare_project/ADB_repo/landing-bronze",
					"baseParameters": {
						"source_system": {
							"value": "@activity('Lookup1').output.firstRow.source_system",
							"type": "Expression"
						},
						"table_name": {
							"value": "@activity('Lookup1').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('Date')",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_ADB",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "bronze-silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "landing-bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Healthcare_project/ADB_repo/bronze-silver",
					"baseParameters": {
						"table_name": {
							"value": "@activity('Lookup1').output.firstRow.source_table_name",
							"type": "Expression"
						},
						"landing_timestamp": {
							"value": "@variables('Date')",
							"type": "Expression"
						},
						"merge_key": {
							"value": "@coalesce(activity('Lookup1').output.firstRow.merge_keys,'')",
							"type": "Expression"
						},
						"load_type": {
							"value": "@activity('Lookup1').output.firstRow.load_type",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_ADB",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Success_status",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "bronze-silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "Project_AzureSqlDb",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update ctrl.audit_log\nset status='SUCCESS',end_time=SYSUTCDATETIME(),records_written=@{activity('bronze-silver').output.runOutput}\nwhere table_id=@{pipeline().parameters.table_id} and adf_run_id='@{pipeline().parameters.get_run_id}'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "If Condition1",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Lookup1",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "curr_Date",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Lookup1').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Lookup_wtr_mrk",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select watermark_value from ctrl.watermark WHERE table_id = @{pipeline().parameters.table_id}",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "AzureSqlTable1",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "water_mark_value",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "Lookup_wtr_mrk",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "watermark",
								"value": {
									"value": "@activity('Lookup_wtr_mrk').output.firstRow.watermark_value",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "ifCond2",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "bronze-silver",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@not(equals(activity('Lookup1').output.firstRow.load_type,'FULL'))",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "Script1",
							"type": "Script",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "Project_AzureSqlDb",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update ctrl.watermark\nset watermark_value = SYSUTCDATETIME()\nwhere table_id=@{activity('Lookup1').output.firstRow.table_id}",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"table_id": {
				"type": "String"
			},
			"get_run_id": {
				"type": "string"
			}
		},
		"variables": {
			"Date": {
				"type": "String"
			},
			"watermark": {
				"type": "String"
			}
		},
		"annotations": []
	}
}