{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-PROJECT100"
		},
		"AzureDataLakeStorage1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://rajastore.dfs.core.windows.net/"
		},
		"AzureKeyVault1_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://project-keyvault-raja.vault.azure.net/"
		},
		"LS_ADB_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1019-100520-wi9br1qz"
		},
		"PostgreSql1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-snowy-bar-b4r6au78-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"PostgreSql1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"PostgreSql1_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"Project_AzureSqlDb_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "project-server.database.windows.net"
		},
		"Project_AzureSqlDb_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-project"
		},
		"Project_AzureSqlDb_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Myproject"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-PROJECT100_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage1_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage1_properties_typeProperties_url')]"
					},
					"AzureKeyVault1_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault1_properties_typeProperties_baseUrl')]"
					},
					"LS_ADB_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_ADB_properties_typeProperties_existingClusterId')]"
					},
					"PostgreSql1_properties_typeProperties_server": {
						"value": "[parameters('PostgreSql1_properties_typeProperties_server')]"
					},
					"PostgreSql1_properties_typeProperties_database": {
						"value": "[parameters('PostgreSql1_properties_typeProperties_database')]"
					},
					"PostgreSql1_properties_typeProperties_username": {
						"value": "[parameters('PostgreSql1_properties_typeProperties_username')]"
					},
					"Project_AzureSqlDb_properties_typeProperties_server": {
						"value": "[parameters('Project_AzureSqlDb_properties_typeProperties_server')]"
					},
					"Project_AzureSqlDb_properties_typeProperties_database": {
						"value": "[parameters('Project_AzureSqlDb_properties_typeProperties_database')]"
					},
					"Project_AzureSqlDb_properties_typeProperties_userName": {
						"value": "[parameters('Project_AzureSqlDb_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}